{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/frontend-check.sh format",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontend-check.sh typecheck",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
